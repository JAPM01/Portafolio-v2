{
  "name": "portafolio-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm ci --prefix v3 && next build && NEXT_PUBLIC_BASE_PATH=/Portafolio-v2/v3 npm run build --prefix v3 && cp -r v3/out out/v3",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/patch-liquid-glass.mjs",
    "test:colors": "node scripts/check-brand-colors.mjs",
    "test:colors:red": "node --test scripts/check-brand-colors.test.mjs",
    "test:colors:propagation": "node --test scripts/test-brand-propagation.mjs",
    "test:typography": "node scripts/check-typography.mjs",
    "test:typography:red": "node --test scripts/check-typography.test.mjs",
    "test:typography:propagation": "node --test scripts/test-typography-propagation.mjs",
    "test:intro-layout": "node --test scripts/test-intro-layout.mjs",
    "test:grid": "node --test scripts/test-site-grid.mjs",
    "test:intro-design": "node --test scripts/test-intro-design.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "0.0.78",
    "liquid-gl": "3.0.0",
    "lucide": "1.73.0",
    "morphicons": "2.0.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
}
